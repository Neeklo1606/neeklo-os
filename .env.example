# Neeklo Parser API (https://neekloai.ru/api/v1/parser/*) — requires a worker online for VK/browser parsing
NEEKLO_API_KEY=
NEEKLO_API_BASE=https://neekloai.ru/api/v1

# OpenRouter — agent orchestration (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Agent API server
PORT=8787
PARSER_POLL_INTERVAL_MS=6000
PARSER_JOB_TIMEOUT_MS=600000

# Companies database (JSON file on server)
# DATABASE_PATH=./data/companies.json
# LEADS_DATABASE_PATH=./data/leads.json
# CAMPAIGNS_DATABASE_PATH=./data/campaigns.json
# AGENT_SESSIONS_DATABASE_PATH=./data/agent-sessions.json

# Frontend build (optional) — public URL agent API when UI on CDN/static host
# VITE_AGENT_API_URL=https://your-host:8787/api/agent
# VITE_COMPANIES_API_URL=https://your-host:8787/api/companies
# VITE_LEADS_API_URL=https://your-host:8787/api/leads
# VITE_CAMPAIGNS_API_URL=https://your-host:8787/api/campaigns

# Neeklo static deploy (optional, local only — never commit)
# NEEKLO_DEPLOY_TOKEN=

# Radar hot-signal alerts (optional — sendTelegramMessage logs and returns
# false if unset, never throws). Bot token from @BotFather; chat id is
# wherever you want alerts delivered (a DM, group, or channel the bot is in).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
