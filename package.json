{
  "name": "osnee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env server/index.mjs",
    "dev:full": "node --env-file=.env server/index.mjs & vite",
    "build": "tsc -b && vite build",
    "start": "node --env-file=.env server/index.mjs",
    "predeploy": "node scripts/backup-before-deploy.mjs",
    "deploy": "npm run build && node --env-file=.env scripts/deploy-static.mjs",
    "predeploy:node": "node scripts/backup-before-deploy.mjs",
    "deploy:node": "node --env-file=.env scripts/deploy-node.mjs",
    "deploy:all": "npm run deploy:node && npm run deploy",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-popover": "^1.1.17",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "node-cron": "^4.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5"
  }
}
